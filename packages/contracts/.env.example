# Used by scripts/deploy-margin.ts (not by `hardhat ignition`, which reads its
# secrets from the Hardhat keystore instead).

# Deployer private key. Not needed for NETWORK=localhost (the node's first
# account is used).
PRIVATE_KEY=

# localhost | hashkeyTestnet (default) | hashkey
NETWORK=hashkeyTestnet

# Optional: override the network's default RPC URL
PROVIDED_URL=

# Optional: use an existing USDT instead of deploying MockUSDT (required on mainnet)
USDT_ADDRESS=
