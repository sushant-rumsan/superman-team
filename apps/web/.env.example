# Required: your Magic publishable API key (https://dashboard.magic.link)
NEXT_PUBLIC_MAGIC_API_KEY=

# Optional: "testnet" (default, chain 133) or "mainnet" (chain 177)
NEXT_PUBLIC_HSK_NETWORK=testnet

# Deployed contract addresses on HSK Chain Testnet (chain 133)
NEXT_PUBLIC_USDT=
NEXT_PUBLIC_ENGINE=

# Server-only (never prefix with NEXT_PUBLIC_). Wallet that sponsors 0.1 HSK of
# gas to each newly created user wallet via /api/fund. Needs a HSK balance.
FUNDER_PRIVATE_KEY=

# Server-only. The engine owner's key (the deployer). /api/kyc uses it to
# self-approve KYC for the demo by calling setKycTier. Needs a little HSK for gas.
OWNER_PRIVATE_KEY=
